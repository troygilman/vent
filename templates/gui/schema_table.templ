package gui

import (
	"fmt"
	"strings"

	"github.com/troygilman/vent"
	"github.com/troygilman/vent/requestctx"
)

type SchemaTableProps struct {
	LayoutProps         LayoutProps
	RouteName           string
	SingularDisplayName string
	PluralDisplayName   string
	Columns             []SchemaTableColumn
	Rows                []SchemaTableRow
	FilterableColumns   []SchemaTableFilterableColumn
	RenderContext       RenderContext
}

type SchemaTableColumn struct {
	Name  string
	Label string
	Type  string
}

type SchemaTableRow struct {
	Cells []SchemaTableCell
}

type SchemaTableCell struct {
	Display string
	LinkURL string
}

type SchemaTableFilterableColumn struct {
	Name  string
	Label string
	Type  string
	Value string
}

type tableFilters struct {
	Signals   map[string]map[string]string
	ShowClear string
	OnClear   string
}

func newTableFilters(columns []SchemaTableFilterableColumn) tableFilters {
	filter := make(map[string]string, len(columns))
	active := make([]string, len(columns))
	reset := make([]string, 0, len(columns)+1)
	for i, column := range columns {
		empty := "''"
		value := column.Value
		if column.Type == "bool" {
			value = vent.BoolFilter(column.Value).Normalize().String()
			empty = "'" + vent.BoolFilterAll.String() + "'"
		}
		filter[column.Name] = value
		active[i] = fmt.Sprintf("$filter.%s !== %s", column.Name, empty)
		reset = append(reset, fmt.Sprintf("$filter.%s = %s", column.Name, empty))
	}
	reset = append(reset, `@get(location.pathname, {filterSignals: {include: /^filter\./}})`)
	return tableFilters{
		Signals:   map[string]map[string]string{"filter": filter},
		ShowClear: strings.Join(active, " || "),
		OnClear:   strings.Join(reset, "; "),
	}
}

templ SchemaTablePage(props SchemaTableProps) {
	{{ schemaPath := fmt.Sprintf("%s%s/", requestctx.MustAdminPath(ctx), props.RouteName) }}
	@Index() {
		@Layout(props.LayoutProps) {
			<div class="page-header">
				<div class="page-title">{ props.PluralDisplayName }</div>
				if props.RenderContext.CanCreate {
					<a href={ templ.SafeURL(schemaPath + "add/") }><button class="btn btn-primary">Add { props.SingularDisplayName }</button></a>
				}
			</div>
			if len(props.FilterableColumns) > 0 {
				{{ filters := newTableFilters(props.FilterableColumns) }}
				<form
					class="table-filters"
					method="get"
					action={ templ.SafeURL(schemaPath) }
					data-signals={ templ.JSONString(filters.Signals) }
					data-push-url="{include: /^filter\./}"
					data-on:submit__prevent="@get(location.pathname, {filterSignals: {include: /^filter\./}})"
				>
					for _, filter := range props.FilterableColumns {
						<label class="table-filter">
							<span class="table-filter-label">{ filter.Label }</span>
							if filter.Type == "string" {
								<div class="input">
									<input type="text" name={ filter.Name } data-bind={ "filter." + filter.Name } value={ filter.Value } placeholder={ "Filter by " + filter.Label }/>
								</div>
							} else if filter.Type == "bool" {
								{{ boolValue := vent.BoolFilter(filter.Value).Normalize() }}
								<select
									class="select"
									name={ filter.Name }
									data-bind={ "filter." + filter.Name }
								>
									<option value={ vent.BoolFilterAll.String() } selected?={ boolValue == vent.BoolFilterAll }>All</option>
									<option value={ vent.BoolFilterTrue.String() } selected?={ boolValue == vent.BoolFilterTrue }>Yes</option>
									<option value={ vent.BoolFilterFalse.String() } selected?={ boolValue == vent.BoolFilterFalse }>No</option>
								</select>
							} else if filter.Type == "int" {
								<div class="input">
									<input type="number" name={ filter.Name } data-bind={ "filter." + filter.Name } value={ filter.Value } placeholder={ "Filter by " + filter.Label }/>
								</div>
							}
						</label>
					}
					<div class="table-filter-actions">
						<button type="submit" class="btn btn-primary" data-indicator="_indicator">Filter</button>
						<button
							type="button"
							class="btn btn-neutral"
							data-show={ filters.ShowClear }
							data-on:click={ filters.OnClear }
							data-indicator="_indicator"
						>
							Clear
						</button>
					</div>
				</form>
			}
			<div class="table-container">
				<table class="data-table">
					<thead>
						<tr>
							for _, column := range props.Columns {
								<th>{ column.Label }</th>
							}
						</tr>
					</thead>
					<tbody>
						if len(props.Rows) == 0 {
							<tr>
								<td class="table-empty" colspan={ fmt.Sprintf("%d", len(props.Columns)) }>No data</td>
							</tr>
						} else {
							for _, row := range props.Rows {
								<tr>
									for _, cell := range row.Cells {
										if cell.LinkURL != "" {
											<td>
												<a class="link" href={ templ.SafeURL(cell.LinkURL) }>
													{ cell.Display }
												</a>
											</td>
										} else {
											<td>{ cell.Display }</td>
										}
									}
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
			@Indicator()
		}
	}
}
