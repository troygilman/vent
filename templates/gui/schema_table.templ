package gui

import (
	"fmt"
	"strconv"
	"strings"

	"github.com/troygilman/vent"
	"github.com/troygilman/vent/requestctx"
)

type SchemaTableProps struct {
	LayoutProps         LayoutProps
	RouteName           string
	SingularDisplayName string
	PluralDisplayName   string
	Columns             []SchemaTableColumn
	Rows                []SchemaTableRow
	FilterableColumns   []SchemaTableFilterableColumn
	Pagination          SchemaTablePagination
	RenderContext       RenderContext
	// Loading is true for the chrome-first HTML response before Datastar
	// fetches rows. That paint must not say "No data".
	Loading bool
}

type SchemaTablePagination struct {
	Page       int
	PageSize   int
	Total      int
	TotalPages int
	From       int
	To         int
	HasPrev    bool
	HasNext    bool
	Signal     string
}

func NewSchemaTablePagination(page vent.ListPage) SchemaTablePagination {
	return SchemaTablePagination{
		Page:       page.Page,
		PageSize:   page.PageSize,
		Total:      page.Total,
		TotalPages: page.TotalPages(),
		From:       page.From(),
		To:         page.To(),
		HasPrev:    page.HasPrev(),
		HasNext:    page.HasNext(),
		Signal:     page.Signal(),
	}
}

func tablePaginationVisible(props SchemaTableProps) bool {
	return !props.Loading && props.Pagination.Total > 0
}

// tableScrollContainerID changes whenever list rows change so Datastar morph
// replaces the overflow element instead of reusing it (which keeps scrollTop).
func tableScrollContainerID(props SchemaTableProps) string {
	parts := []string{
		"schema-table-scroll",
		strconv.Itoa(props.Pagination.Page),
		strconv.Itoa(props.Pagination.From),
		strconv.Itoa(props.Pagination.To),
	}
	if props.Loading {
		parts = append(parts, "loading")
	}
	for _, column := range props.FilterableColumns {
		if !tableFilterActive(column) {
			continue
		}
		parts = append(parts, column.Name, tableScrollIDToken(tableFilterChipValue(column)))
	}
	if len(props.Rows) > 0 && len(props.Rows[0].Cells) > 0 {
		parts = append(parts, tableScrollIDToken(props.Rows[0].Cells[0].Display))
	}
	return strings.Join(parts, "-")
}

func tableScrollIDToken(s string) string {
	var b strings.Builder
	for _, r := range s {
		if r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9' {
			b.WriteRune(r)
		} else if b.Len() > 0 {
			b.WriteByte('-')
		}
		if b.Len() >= 24 {
			break
		}
	}
	return strings.Trim(b.String(), "-")
}

func tableListQueryStringExpr() string {
	return `{include: /^(filter\.|page$)/}`
}

func tableListFetchExpr() string {
	return `@get(location.pathname, {filterSignals: {include: /^(filter\.|page$)/}}); setTimeout(() => window.tableFetch.resetScroll())`
}

func tableFetchDispatchExpr() string {
	return `window.tableFetch.dispatch(el)`
}

func tableFilterChangeExpr() string {
	return `$page = ''; window.tableFetch.dispatch(el)`
}

func tablePageClickExpr(n int) string {
	page := ""
	if n > 1 {
		page = strconv.Itoa(n)
	}
	return fmt.Sprintf(`$page = %q; window.tableFetch.dispatch(el)`, page)
}

type SchemaTableColumn struct {
	Name  string
	Label string
	Type  string
}

type SchemaTableRow struct {
	Cells []SchemaTableCell
}

type SchemaTableCell struct {
	Display string
	LinkURL string
}

type SchemaTableFilterableColumn struct {
	Name  string
	Label string
	Type  string
	Value string
}

func tableFilterActive(column SchemaTableFilterableColumn) bool {
	if column.Type == "bool" {
		_, ok := vent.BoolFilter(column.Value).Bool()
		return ok
	}
	return column.Value != ""
}

func tableFiltersActive(columns []SchemaTableFilterableColumn) bool {
	for _, column := range columns {
		if tableFilterActive(column) {
			return true
		}
	}
	return false
}

func tableFilterActiveCount(columns []SchemaTableFilterableColumn) int {
	n := 0
	for _, column := range columns {
		if tableFilterActive(column) {
			n++
		}
	}
	return n
}

func tableFilterChipValue(column SchemaTableFilterableColumn) string {
	if column.Type == "bool" {
		v, ok := vent.BoolFilter(column.Value).Bool()
		if !ok {
			return ""
		}
		if v {
			return "Yes"
		}
		return "No"
	}
	return column.Value
}

func tableFilterResetClick(names []string) string {
	quoted := make([]string, len(names))
	for i, name := range names {
		quoted[i] = fmt.Sprintf("%q", name)
	}
	return fmt.Sprintf("tableFilters.dispatch(el, {filterNames: [%s]})", strings.Join(quoted, ", "))
}

func tableFilterClearClick(name string) string {
	return tableFilterResetClick([]string{name})
}

func tableFilterResetAllClick(columns []SchemaTableFilterableColumn) string {
	names := make([]string, len(columns))
	for i, column := range columns {
		names[i] = column.Name
	}
	return tableFilterResetClick(names)
}

func tableWidgetsCookieExpr(adminPath string) string {
	return fmt.Sprintf(`{include: /^widgets\./, path: %q}`, adminPath)
}

// tableColumnKind maps a list-column type to a stable layout kind used for
// table-layout:fixed widths. Cell content must not change these kinds, or
// lazy-loaded rows will shift the headers.
func tableColumnKind(colType string) string {
	switch colType {
	case "bool":
		return "bool"
	case "int", "int8", "int16", "int32", "int64",
		"uint", "uint8", "uint16", "uint32", "uint64",
		"float", "float32", "float64":
		return "num"
	case "time", "time.Time":
		return "time"
	default:
		return "text"
	}
}

func tableColumnWeight(colType string) int {
	switch tableColumnKind(colType) {
	case "bool":
		return 5
	case "num":
		return 4
	case "time":
		return 7
	default:
		return 12
	}
}

// tableColumnWidthPercent is a content-independent width so lazy-loaded rows
// cannot shift headers. The last column absorbs rounding remainder.
func tableColumnWidthPercent(columns []SchemaTableColumn, index int) string {
	if len(columns) == 0 || index < 0 || index >= len(columns) {
		return ""
	}
	total := 0
	weights := make([]int, len(columns))
	for i, column := range columns {
		w := tableColumnWeight(column.Type)
		weights[i] = w
		total += w
	}
	if total == 0 {
		return ""
	}
	if index == len(columns)-1 {
		used := 0
		for i := 0; i < index; i++ {
			used += weights[i] * 100 / total
		}
		return fmt.Sprintf("%d%%", 100-used)
	}
	return fmt.Sprintf("%d%%", weights[index]*100/total)
}

templ SchemaTablePage(props SchemaTableProps) {
	{{ adminPath := requestctx.MustAdminPath(ctx) }}
	{{ schemaPath := fmt.Sprintf("%s%s/", adminPath, props.RouteName) }}
	{{ filtersActive := tableFiltersActive(props.FilterableColumns) }}
	{{ filterCount := tableFilterActiveCount(props.FilterableColumns) }}
	{{ widgets := tableWidgetsState(ctx) }}
	@Index() {
		@Layout(props.LayoutProps) {
			<form
				id="schema-table-filters"
				class="table-filters"
				data-signals__ifmissing={ templ.JSONString(widgetDrawerSignals{Widgets: widgets}) }
				data-cookie:vent-widgets={ tableWidgetsCookieExpr(adminPath) }
				data-query-string__history={ tableListQueryStringExpr() }
				data-on:query-string={ tableFetchDispatchExpr() }
				data-on:change={ tableFilterChangeExpr() }
				data-on:table-fetch={ tableListFetchExpr() }
				data-on:table-filter-reset="tableFilters.onReset($filter, evt)"
				data-on:submit__prevent="void 0"
				data-indicator="_indicator"
			>
				if !props.Loading {
					<input type="hidden" name="page" data-bind="page" value={ props.Pagination.Signal }/>
				}
				<div class="page-with-widgets-main">
					<div class="page-header">
						<div class="page-title">{ props.PluralDisplayName }</div>
						if props.RenderContext.CanCreate {
							<a class="btn btn-primary" href={ templ.SafeURL(schemaPath + "add/") }>Add { props.SingularDisplayName }</a>
						}
					</div>
					if filtersActive {
						<div class="table-filter-toolbar">
							<div class="table-filter-chips">
								for _, filter := range props.FilterableColumns {
									if tableFilterActive(filter) {
										<span class="table-filter-chip">
											<span class="table-filter-chip-text">
												{ filter.Label }: <b>{ tableFilterChipValue(filter) }</b>
											</span>
											<button
												type="button"
												class="table-filter-chip-remove"
												aria-label={ "Remove " + filter.Label + " filter" }
												data-on:click={ tableFilterClearClick(filter.Name) }
											>
												×
											</button>
										</span>
									}
								}
							</div>
							<button
								type="button"
								class="btn btn-sm btn-outline"
								data-on:click={ tableFilterResetAllClick(props.FilterableColumns) }
							>
								Clear
							</button>
						</div>
					}
					@schemaTable(props)
				</div>
				<aside
					class={ "widget-drawer", templ.KV("is-open", widgets.Open) }
					data-class:is-open="$widgets._open"
					aria-label="Widgets"
				>
					<div class="widget-drawer-rail" role="toolbar" aria-label="Widgets">
						<div class="widget-drawer-rail-header">
							<button
								type="button"
								class="widget-drawer-icon"
								if widgets.Open {
									aria-label="Collapse drawer"
									aria-expanded="true"
								} else {
									aria-label="Expand drawer"
									aria-expanded="false"
								}
								data-attr:aria-label="$widgets._open ? 'Collapse drawer' : 'Expand drawer'"
								data-attr:aria-expanded="$widgets._open"
								data-on:click="widgetDrawer.toggleOpen($widgets)"
							>
								@DrawerToggleIcon()
							</button>
						</div>
						<div class="widget-drawer-rail-widgets">
							<button
								type="button"
								class={ "widget-drawer-icon", templ.KV("is-active", tableWidgetsFilterActive(widgets)) }
								aria-label="Filters"
								aria-controls="widget-filter-panel"
								if tableWidgetsFilterActive(widgets) {
									aria-expanded="true"
								} else {
									aria-expanded="false"
								}
								data-attr:aria-expanded="$widgets._open && $widgets.active === 'filter'"
								data-class:is-active="$widgets._open && $widgets.active === 'filter'"
								data-on:click="widgetDrawer.open($widgets, 'filter')"
							>
								@FilterIcon()
								if filterCount > 0 {
									<span class="widget-drawer-badge">{ fmt.Sprintf("%d", filterCount) }</span>
								}
							</button>
						</div>
					</div>
					<div class="widget-drawer-panel">
						<div id="widget-filter-panel" class="widget-drawer-widget">
							<div class="widget-drawer-header">
								<div class="widget-drawer-title">Filters</div>
							</div>
							<div class="widget-drawer-body">
								if len(props.FilterableColumns) == 0 {
									<p class="widget-drawer-empty">No filters available</p>
								} else {
									for _, filter := range props.FilterableColumns {
										@schemaTableFilterField(filter)
									}
								}
							</div>
							if filtersActive {
								<div class="widget-drawer-footer">
									<button
										type="button"
										class="btn btn-sm btn-outline"
										data-on:click={ tableFilterResetAllClick(props.FilterableColumns) }
									>
										Clear
									</button>
								</div>
							}
						</div>
					</div>
				</aside>
			</form>
			@Indicator()
		}
	}
}

templ schemaTable(props SchemaTableProps) {
	<div class="schema-table">
		<div id={ tableScrollContainerID(props) } class="table-container">
			<table class="data-table">
				<colgroup>
					for i := range props.Columns {
						<col width={ tableColumnWidthPercent(props.Columns, i) }/>
					}
				</colgroup>
				<thead>
					<tr>
						for _, column := range props.Columns {
							<th title={ column.Label }>{ column.Label }</th>
						}
					</tr>
				</thead>
				<tbody>
					if !props.Loading && len(props.Rows) == 0 {
						<tr>
							<td class="table-empty" colspan={ fmt.Sprintf("%d", len(props.Columns)) }>No data</td>
						</tr>
					} else {
						for _, row := range props.Rows {
							<tr>
								for _, cell := range row.Cells {
									if cell.LinkURL != "" {
										<td title={ cell.Display }>
											<a class="link" href={ templ.SafeURL(cell.LinkURL) }>
												{ cell.Display }
											</a>
										</td>
									} else {
										<td title={ cell.Display }>{ cell.Display }</td>
									}
								}
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
		if tablePaginationVisible(props) {
			@schemaTablePagination(props.Pagination)
		}
	</div>
}

templ schemaTablePagination(p SchemaTablePagination) {
	<nav class="table-pagination" aria-label="Pagination">
		<button
			type="button"
			class="btn btn-sm btn-outline"
			aria-label="First page"
			disabled?={ !p.HasPrev }
			if p.HasPrev {
				data-on:click={ tablePageClickExpr(1) }
			}
		>
			First
		</button>
		<button
			type="button"
			class="btn btn-sm btn-outline"
			aria-label="Previous page"
			disabled?={ !p.HasPrev }
			if p.HasPrev {
				data-on:click={ tablePageClickExpr(p.Page - 1) }
			}
		>
			Prev
		</button>
		<div class="table-pagination-status">
			<div class="table-pagination-page">Page { fmt.Sprintf("%d of %d", p.Page, p.TotalPages) }</div>
			<div class="table-pagination-range">{ fmt.Sprintf("%d–%d of %d", p.From, p.To, p.Total) }</div>
		</div>
		<button
			type="button"
			class="btn btn-sm btn-outline"
			aria-label="Next page"
			disabled?={ !p.HasNext }
			if p.HasNext {
				data-on:click={ tablePageClickExpr(p.Page + 1) }
			}
		>
			Next
		</button>
		<button
			type="button"
			class="btn btn-sm btn-outline"
			aria-label="Last page"
			disabled?={ !p.HasNext }
			if p.HasNext {
				data-on:click={ tablePageClickExpr(p.TotalPages) }
			}
		>
			Last
		</button>
	</nav>
}

templ schemaTableFilterField(filter SchemaTableFilterableColumn) {
	<label class="table-filter">
		<span class="table-filter-label">{ filter.Label }</span>
		if filter.Type == "string" {
			<div class="input">
				<input
					type="text"
					name={ "filter." + filter.Name }
					data-bind__event.change={ "filter." + filter.Name }
					value={ filter.Value }
					placeholder={ "Filter by " + filter.Label }
				/>
			</div>
		} else if filter.Type == "bool" {
			{{ boolValue := vent.BoolFilter(filter.Value).Normalize() }}
			<select
				class="select"
				name={ "filter." + filter.Name }
				data-bind={ "filter." + filter.Name }
			>
				<option value={ vent.BoolFilterAll.String() } selected?={ boolValue == vent.BoolFilterAll }>All</option>
				<option value={ vent.BoolFilterTrue.String() } selected?={ boolValue == vent.BoolFilterTrue }>Yes</option>
				<option value={ vent.BoolFilterFalse.String() } selected?={ boolValue == vent.BoolFilterFalse }>No</option>
			</select>
		} else if filter.Type == "int" {
			<div class="input">
				<input
					type="text"
					inputmode="numeric"
					name={ "filter." + filter.Name }
					data-bind__event.change={ "filter." + filter.Name }
					value={ filter.Value }
					placeholder={ "Filter by " + filter.Label }
				/>
			</div>
		}
	</label>
}
