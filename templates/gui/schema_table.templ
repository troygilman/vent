package gui

import (
	"fmt"

	"github.com/troygilman/vent/requestctx"
)

type SchemaTableProps struct {
	LayoutProps         LayoutProps
	RouteName           string
	SingularDisplayName string
	PluralDisplayName   string
	Columns             []SchemaTableColumn
	Rows                []SchemaTableRow
	FilterableColumns   []SchemaTableFilterableColumn
	RenderContext       RenderContext
}

type SchemaTableColumn struct {
	Name  string
	Label string
	Type  string
}

type SchemaTableRow struct {
	Cells []SchemaTableCell
}

type SchemaTableCell struct {
	Display string
	LinkURL string
}

type SchemaTableFilterableColumn struct {
	Name  string
	Label string
	Type  string
}

templ SchemaTablePage(props SchemaTableProps) {
	{{ schemaPath := fmt.Sprintf("%s%s/", requestctx.MustAdminPath(ctx), props.RouteName) }}
	@Index() {
		@Layout(props.LayoutProps) {
			<div class="page-header">
				<div class="page-title">{ props.PluralDisplayName }</div>
				if props.RenderContext.CanCreate {
					<a href={ templ.SafeURL(schemaPath + "add/") }><button class="btn btn-primary">Add { props.SingularDisplayName }</button></a>
				}
			</div>
			if len(props.FilterableColumns) > 0 {
				<div class="filter-container" style="margin-bottom: 1rem; padding: 1rem; background: var(--surface-color); border-radius: 0.5rem;">
					<div style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: end;">
						for _, filter := range props.FilterableColumns {
							<div style="display: flex; flex-direction: column; gap: 0.25rem;">
								<label style="font-size: 0.875rem; font-weight: 500;">{ filter.Label }</label>
								if filter.Type == "string" {
									<input
										type="text"
										name={ "filter_" + filter.Name }
										placeholder={ "Filter by " + filter.Label }
										style="padding: 0.5rem; border: 1px solid var(--border-color); border-radius: 0.25rem; min-width: 200px;"
										data-model={ "filters." + filter.Name }
									/>
								} else if filter.Type == "bool" {
									<select
										name={ "filter_" + filter.Name }
										style="padding: 0.5rem; border: 1px solid var(--border-color); border-radius: 0.25rem; min-width: 150px;"
										data-model={ "filters." + filter.Name }
									>
										<option value="">All</option>
										<option value="true">Yes</option>
										<option value="false">No</option>
									</select>
								}
							</div>
						}
						<button
							class="btn btn-secondary"
							style="padding: 0.5rem 1rem;"
							data-on-click="$$get({ url: window.location.pathname, queries: $filters })"
						>
							Apply Filters
						</button>
						<button
							class="btn btn-secondary"
							style="padding: 0.5rem 1rem;"
							data-on-click="$filters = {}; $$get({ url: window.location.pathname })"
						>
							Clear Filters
						</button>
					</div>
				</div>
			}
			<div class="table-container">
				<table class="data-table">
					<thead>
						<tr>
							for _, column := range props.Columns {
								<th>{ column.Label }</th>
							}
						</tr>
					</thead>
					<tbody>
						if len(props.Rows) == 0 {
							<tr>
								<td class="table-empty" colspan={ fmt.Sprintf("%d", len(props.Columns)) }>No data</td>
							</tr>
						} else {
							for _, row := range props.Rows {
								<tr>
									for _, cell := range row.Cells {
										if cell.LinkURL != "" {
											<td>
												<a class="link" href={ templ.SafeURL(cell.LinkURL) }>
													{ cell.Display }
												</a>
											</td>
										} else {
											<td>{ cell.Display }</td>
										}
									}
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		}
	}
}
