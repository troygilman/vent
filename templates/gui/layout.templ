package gui

import "github.com/troygilman/vent/requestctx"

type LayoutProps struct {
	Schemas          []SchemaMetadata
	ActiveSchemaName string
	Breadcrumbs      []BreadcrumbItem
}

type SchemaMetadata struct {
	Name        string
	DisplayName string
	Path        string
}

templ Layout(props LayoutProps) {
	<div class="admin-layout">
		<div class="sidebar">
			<div class="sidebar-brand">
				<div class="sidebar-brand-title">Vent</div>
				<div class="sidebar-brand-subtitle">Admin</div>
			</div>
			<ul class="sidebar-nav">
				<li class={ "nav-item", templ.KV("active", props.ActiveSchemaName == "") }>
					<a href={ templ.SafeURL(requestctx.MustAdminPath(ctx)) } class="nav-link">
						@HomeIcon()
						Home
					</a>
				</li>
				<li class="nav-title">Schemas</li>
				for _, schema := range props.Schemas {
					<li class={ "nav-item", templ.KV("active", schema.Name == props.ActiveSchemaName) }>
						<a href={ schema.Path } class="nav-link">{ schema.DisplayName }</a>
					</li>
				}
				<li class="nav-spacer"></li>
				<li class="nav-item">
					@ThemeToggle(requestctx.MustTheme(ctx))
				</li>
				<li class="nav-item">
					<button
						type="button"
						class="nav-link nav-link-muted"
						data-on:click={ "@post('" + requestctx.MustAdminPath(ctx) + "logout/')" }
						data-indicator="_indicator"
					>
						@LogoutIcon()
						Logout
					</button>
				</li>
			</ul>
		</div>
		<div class="content-area">
			if len(props.Breadcrumbs) > 0 {
				<div class="content-chrome">
					<div class="content-chrome-inner">
						@Breadcrumbs(props.Breadcrumbs)
					</div>
				</div>
			}
			<div class="content-main">
				<div class="page-content">
					{ children... }
				</div>
			</div>
		</div>
	</div>
}
