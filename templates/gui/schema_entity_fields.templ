package gui

type SelectOption struct {
	Value    int
	Label    string
	Selected bool
}

type SchemaEntityTextFieldProps struct {
	Name        string
	Label       string
	Value       string
	Editable    bool
	Desc        string
	ActionLabel string
	ActionURL   string
}

type SchemaEntityPasswordFieldProps struct {
	Name     string
	Label    string
	Editable bool
	Desc     string
}

type SchemaEntityIntFieldProps struct {
	Name     string
	Label    string
	Value    string
	Editable bool
	Desc     string
}

type SchemaEntityFloatFieldProps struct {
	Name     string
	Label    string
	Value    string
	Editable bool
	Desc     string
}

type SchemaEntityBoolFieldProps struct {
	Name     string
	Label    string
	Value    string
	Editable bool
	Desc     string
}

type SchemaEntityTimeFieldProps struct {
	Name     string
	Label    string
	Value    string
	Editable bool
	Desc     string
}

type SchemaEntityForeignKeyUniqueFieldProps struct {
	Name       string
	Label      string
	Editable   bool
	Desc       string
	Options    []SelectOption
	OptionsURL string
}

type SchemaEntityForeignKeyFieldProps struct {
	Name       string
	Label      string
	Editable   bool
	Desc       string
	Options    []SelectOption
	OptionsURL string
}

type FkOptionListProps struct {
	Name     string
	Unique   bool
	Options  []SelectOption
	Query    string
	Fetch    string
	Editable bool
}

templ FkOptionList(props FkOptionListProps) {
	<div id={ fkOptionsElementID(props.Name) } class="fk-combobox-results">
		if props.Unique {
			{{ selectedLabel := fkSelectedLabel(props.Options) }}
			if selectedLabel != "" {
				<span class="fk-chip">
					{ selectedLabel }
					if props.Editable {
						<button type="button" class="fk-clear" data-on:mousedown__prevent="true" data-on:click={ fkClearUnique(props.Name) + "; " + props.Fetch } aria-label="Clear">×</button>
					}
				</span>
			}
		} else {
			<div class="fk-chips">
				for _, opt := range props.Options {
					if opt.Selected {
						<span class="fk-chip">
							{ opt.Label }
							if props.Editable {
								<button type="button" class="fk-clear" data-on:mousedown__prevent="true" data-on:click={ fkRemoveMany(props.Name, opt.Value) + "; " + props.Fetch } aria-label="Remove">×</button>
							}
						</span>
					}
				}
			</div>
		}
		<div class="fk-option-list" role="listbox">
			if len(props.Options) == 0 {
				<div class="fk-option-empty">
					if props.Query == "" {
						No options
					} else {
						No matches for “{ props.Query }”
					}
				</div>
			} else {
				for _, opt := range props.Options {
					<button
						type="button"
						class={ "fk-option", templ.KV("selected", opt.Selected) }
						role="option"
						tabindex="-1"
						data-on:mousedown__prevent="true"
						if props.Unique {
							data-on:click={ fkSelectUnique(props.Name, opt.Value, opt.Label) + "; " + props.Fetch }
						} else {
							data-on:click={ fkAddMany(props.Name, opt.Value) + "; " + props.Fetch }
						}
					>
						{ opt.Label }
					</button>
				}
			}
		</div>
	</div>
}

templ SchemaEntityTextField(props SchemaEntityTextFieldProps) {
	<div class="field-group">
		<label class="field">
			<span class="field-label">{ props.Label }</span>
			<div class="input">
				<input
					type="text"
					if props.Editable {
						data-bind={ entitySignal(props.Name) }
					}
					value={ props.Value }
					readonly?={ !props.Editable }
					disabled?={ !props.Editable }
				/>
				if props.ActionLabel != "" && props.ActionURL != "" {
					<a class="btn btn-neutral btn-sm" href={ templ.SafeURL(props.ActionURL) }>{ props.ActionLabel }</a>
				}
			</div>
		</label>
		if props.Desc != "" {
			<p class="field-desc">{ props.Desc }</p>
		}
	</div>
}

templ SchemaEntityPasswordField(props SchemaEntityPasswordFieldProps) {
	<div class="field-group">
		<label class="field">
			<span class="field-label">{ props.Label }</span>
			<div class="input">
				<input
					type="password"
					if props.Editable {
						data-bind={ entitySignal(props.Name) }
					}
					placeholder="Enter new password"
					readonly?={ !props.Editable }
					disabled?={ !props.Editable }
				/>
			</div>
		</label>
		if props.Desc != "" {
			<p class="field-desc">{ props.Desc }</p>
		}
	</div>
}

templ SchemaEntityIntField(props SchemaEntityIntFieldProps) {
	<div class="field-group">
		<label class="field">
			<span class="field-label">{ props.Label }</span>
			<div class="input">
				<input
					type="number"
					step="1"
					if props.Editable {
						data-bind={ entitySignal(props.Name) }
					}
					value={ props.Value }
					readonly?={ !props.Editable }
					disabled?={ !props.Editable }
				/>
			</div>
		</label>
		if props.Desc != "" {
			<p class="field-desc">{ props.Desc }</p>
		}
	</div>
}

templ SchemaEntityFloatField(props SchemaEntityFloatFieldProps) {
	<div class="field-group">
		<label class="field">
			<span class="field-label">{ props.Label }</span>
			<div class="input">
				<input
					type="number"
					step="any"
					if props.Editable {
						data-bind={ entitySignal(props.Name) }
					}
					value={ props.Value }
					readonly?={ !props.Editable }
					disabled?={ !props.Editable }
				/>
			</div>
		</label>
		if props.Desc != "" {
			<p class="field-desc">{ props.Desc }</p>
		}
	</div>
}

templ SchemaEntityBoolField(props SchemaEntityBoolFieldProps) {
	<div class="field-group">
		<label class="field field-checkbox">
			<span class="field-label">{ props.Label }</span>
			<input
				class="checkbox checkbox-sm"
				type="checkbox"
				if props.Editable {
					data-bind={ entitySignal(props.Name) }
				}
				checked?={ props.Value == "true" }
				disabled?={ !props.Editable }
			/>
		</label>
		if props.Desc != "" {
			<p class="field-desc">{ props.Desc }</p>
		}
	</div>
}

templ SchemaEntityTimeField(props SchemaEntityTimeFieldProps) {
	<div class="field-group">
		<label class="field">
			<span class="field-label">{ props.Label }</span>
			<div class="input">
				<input
					type="datetime-local"
					if props.Editable {
						data-bind={ entitySignal(props.Name) }
					}
					value={ props.Value }
					readonly?={ !props.Editable }
					disabled?={ !props.Editable }
				/>
			</div>
		</label>
		if props.Desc != "" {
			<p class="field-desc">{ props.Desc }</p>
		}
	</div>
}

templ SchemaEntityForeignKeyUniqueField(props SchemaEntityForeignKeyUniqueFieldProps) {
	{{ fetch := FkOptionsFetch(props.OptionsURL, props.Name) }}
	{{ selectedID := fkSelectedID(props.Options) }}
	{{ selectedLabel := fkSelectedLabel(props.Options) }}
	<div class="field-group" data-signals={ templ.JSONString(fkUniqueSignals(props.Name, selectedID, selectedLabel)) }>
		<div class="field">
			<span class="field-label">{ props.Label }</span>
			<div class="fk-combobox" data-class:is-open={ fkIsOpenExpr(props.Name) }>
				<div class="fk-combobox-face" data-on:mousedown="fkCombobox.focusFromFace(evt)">
					@FkOptionList(FkOptionListProps{
						Name:     props.Name,
						Unique:   true,
						Options:  props.Options,
						Fetch:    fetch,
						Editable: props.Editable,
					})
					if props.Editable {
						<input
							type="text"
							class="fk-combobox-input"
							placeholder="Search..."
							role="combobox"
							aria-autocomplete="list"
							aria-controls={ fkOptionsElementID(props.Name) }
							autocomplete="off"
							spellcheck="false"
							data-bind={ fkSearchSignal(props.Name) }
							data-on:focus={ fkOpen(props.Name) }
							data-on:focus__debounce.200ms={ fetch }
							data-on:input={ fkOnInput(props.Name) }
							data-on:input__debounce.200ms={ fetch }
							data-on:keydown={ fkKeydown(props.Name) }
							data-on:blur={ fkBlur(props.Name) }
						/>
					} else {
						if selectedLabel != "" {
							<span class="fk-combobox-static">{ selectedLabel }</span>
						}
					}
				</div>
			</div>
		</div>
		if props.Desc != "" {
			<p class="field-desc">{ props.Desc }</p>
		}
	</div>
}

templ SchemaEntityForeignKeyField(props SchemaEntityForeignKeyFieldProps) {
	{{ fetch := FkOptionsFetch(props.OptionsURL, props.Name) }}
	{{ selectedIDs := fkSelectedIDs(props.Options) }}
	<div class="field-group" data-signals={ templ.JSONString(fkManySignals(props.Name, selectedIDs)) }>
		<div class="field">
			<span class="field-label">{ props.Label }</span>
			<div class="fk-combobox fk-combobox-many" data-class:is-open={ fkIsOpenExpr(props.Name) }>
				<div class="fk-combobox-face" data-on:mousedown="fkCombobox.focusFromFace(evt)">
					@FkOptionList(FkOptionListProps{
						Name:     props.Name,
						Unique:   false,
						Options:  props.Options,
						Fetch:    fetch,
						Editable: props.Editable,
					})
					if props.Editable {
						<input
							type="text"
							class="fk-combobox-input"
							placeholder="Search..."
							role="combobox"
							aria-autocomplete="list"
							aria-controls={ fkOptionsElementID(props.Name) }
							autocomplete="off"
							spellcheck="false"
							data-bind={ fkSearchSignal(props.Name) }
							data-on:focus={ fkOpen(props.Name) }
							data-on:focus__debounce.200ms={ fetch }
							data-on:input={ fkOnInput(props.Name) }
							data-on:input__debounce.200ms={ fetch }
							data-on:keydown={ fkKeydown(props.Name) }
							data-on:blur={ fkBlur(props.Name) }
						/>
					}
				</div>
			</div>
		</div>
		if props.Desc != "" {
			<p class="field-desc">{ props.Desc }</p>
		}
	</div>
}
