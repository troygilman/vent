package gui

type SelectOption struct {
	Value    int
	Label    string
	Selected bool
}

// FKOptions is a search-hit dropdown plus committed chips (not injected into hits).
type FKOptions struct {
	Options []SelectOption
	Chips   []SelectOption
}

type SchemaEntityTextFieldProps struct {
	Name        string
	Label       string
	Value       string
	Editable    bool
	Desc        string
	ActionLabel string
	ActionURL   string
}

type SchemaEntityPasswordFieldProps struct {
	Name     string
	Label    string
	Editable bool
	Desc     string
}

type SchemaEntityIntFieldProps struct {
	Name     string
	Label    string
	Value    string
	Editable bool
	Desc     string
}

type SchemaEntityFloatFieldProps struct {
	Name     string
	Label    string
	Value    string
	Editable bool
	Desc     string
}

type SchemaEntityBoolFieldProps struct {
	Name     string
	Label    string
	Value    string
	Editable bool
	Desc     string
}

type SchemaEntityTimeFieldProps struct {
	Name     string
	Label    string
	Value    string
	Editable bool
	Desc     string
}

type SchemaEntityForeignKeyUniqueFieldProps struct {
	Name       string
	Label      string
	Editable   bool
	Desc       string
	Options    []SelectOption
	Chips      []SelectOption
	OptionsURL string
}

type SchemaEntityForeignKeyFieldProps struct {
	Name       string
	Label      string
	Editable   bool
	Desc       string
	Options    []SelectOption
	Chips      []SelectOption
	OptionsURL string
}

type FkOptionListProps struct {
	Name    string
	Unique  bool
	Options []SelectOption
	Query   string
}

templ FkOptionList(props FkOptionListProps) {
	<div id={ fkOptionsElementID(props.Name) } class="fk-combobox-results">
		<div class="fk-option-list" role="listbox">
			if len(props.Options) == 0 {
				<div class="fk-option-empty">
					if props.Query == "" {
						No options
					} else {
						No matches for “{ props.Query }”
					}
				</div>
			} else {
				for _, opt := range props.Options {
					<button
						type="button"
						class={ "fk-option", templ.KV("selected", opt.Selected) }
						role="option"
						tabindex="-1"
						data-on:mousedown__prevent="true"
						if props.Unique {
							data-on:click={ fkSelectUnique(props.Name, opt.Value, opt.Label) }
						} else {
							data-on:click={ fkAddMany(props.Name, opt.Value, opt.Label) }
						}
					>
						{ opt.Label }
					</button>
				}
			}
		</div>
	</div>
}

templ SchemaEntityTextField(props SchemaEntityTextFieldProps) {
	<div class="field-group">
		<label class="field">
			<span class="field-label">{ props.Label }</span>
			<div class="input">
				<input
					type="text"
					if props.Editable {
						data-bind={ entitySignal(props.Name) }
					}
					value={ props.Value }
					readonly?={ !props.Editable }
					disabled?={ !props.Editable }
				/>
				if props.ActionLabel != "" && props.ActionURL != "" {
					<a class="btn btn-neutral btn-sm" href={ templ.SafeURL(props.ActionURL) }>{ props.ActionLabel }</a>
				}
			</div>
		</label>
		if props.Desc != "" {
			<p class="field-desc">{ props.Desc }</p>
		}
	</div>
}

templ SchemaEntityPasswordField(props SchemaEntityPasswordFieldProps) {
	<div class="field-group">
		<label class="field">
			<span class="field-label">{ props.Label }</span>
			<div class="input">
				<input
					type="password"
					if props.Editable {
						data-bind={ entitySignal(props.Name) }
					}
					placeholder="Enter new password"
					readonly?={ !props.Editable }
					disabled?={ !props.Editable }
				/>
			</div>
		</label>
		if props.Desc != "" {
			<p class="field-desc">{ props.Desc }</p>
		}
	</div>
}

templ SchemaEntityIntField(props SchemaEntityIntFieldProps) {
	<div class="field-group">
		<label class="field">
			<span class="field-label">{ props.Label }</span>
			<div class="input">
				<input
					type="number"
					step="1"
					if props.Editable {
						data-bind={ entitySignal(props.Name) }
					}
					value={ props.Value }
					readonly?={ !props.Editable }
					disabled?={ !props.Editable }
				/>
			</div>
		</label>
		if props.Desc != "" {
			<p class="field-desc">{ props.Desc }</p>
		}
	</div>
}

templ SchemaEntityFloatField(props SchemaEntityFloatFieldProps) {
	<div class="field-group">
		<label class="field">
			<span class="field-label">{ props.Label }</span>
			<div class="input">
				<input
					type="number"
					step="any"
					if props.Editable {
						data-bind={ entitySignal(props.Name) }
					}
					value={ props.Value }
					readonly?={ !props.Editable }
					disabled?={ !props.Editable }
				/>
			</div>
		</label>
		if props.Desc != "" {
			<p class="field-desc">{ props.Desc }</p>
		}
	</div>
}

templ SchemaEntityBoolField(props SchemaEntityBoolFieldProps) {
	<div class="field-group">
		<label class="field field-checkbox">
			<span class="field-label">{ props.Label }</span>
			<input
				class="checkbox checkbox-sm"
				type="checkbox"
				if props.Editable {
					data-bind={ entitySignal(props.Name) }
				}
				checked?={ props.Value == "true" }
				disabled?={ !props.Editable }
			/>
		</label>
		if props.Desc != "" {
			<p class="field-desc">{ props.Desc }</p>
		}
	</div>
}

templ SchemaEntityTimeField(props SchemaEntityTimeFieldProps) {
	<div class="field-group">
		<label class="field">
			<span class="field-label">{ props.Label }</span>
			<div class="input">
				<input
					type="datetime-local"
					if props.Editable {
						data-bind={ entitySignal(props.Name) }
					}
					value={ props.Value }
					readonly?={ !props.Editable }
					disabled?={ !props.Editable }
				/>
			</div>
		</label>
		if props.Desc != "" {
			<p class="field-desc">{ props.Desc }</p>
		}
	</div>
}

templ SchemaEntityForeignKeyUniqueField(props SchemaEntityForeignKeyUniqueFieldProps) {
	{{ fetch := fkFetchIfOpen(props.OptionsURL, props.Name) }}
	{{ selectedID := fkSelectedID(props.Chips) }}
	{{ selectedLabel := fkSelectedLabel(props.Chips) }}
	<div class="field-group" data-signals={ templ.JSONString(fkUniqueSignals(props.Name, selectedID, selectedLabel)) }>
		<div class="field">
			<span class="field-label">{ props.Label }</span>
			<div class="fk-combobox" data-class:is-open={ fkIsOpenExpr(props.Name) }>
				<div class="fk-combobox-face" data-on:mousedown="fkCombobox.focusFromFace(evt)">
					<span class="fk-chip" data-show={ fkHasLabelExpr(props.Name) }>
						<span data-text={ fkLabelTextExpr(props.Name) }>{ selectedLabel }</span>
						if props.Editable {
							<button type="button" class="fk-clear" data-on:mousedown__prevent="true" data-on:click={ fkClearUnique(props.Name) } aria-label="Clear">×</button>
						}
					</span>
					if props.Editable {
						<input
							type="text"
							class="fk-combobox-input"
							placeholder="Search..."
							role="combobox"
							aria-autocomplete="list"
							aria-controls={ fkOptionsElementID(props.Name) }
							autocomplete="off"
							spellcheck="false"
							data-bind={ fkSearchSignal(props.Name) }
							data-on:focus={ fkOpen(props.Name) }
							data-on:focus__debounce.200ms={ fetch }
							data-on:input={ fkOnInput(props.Name) }
							data-on:input__debounce.200ms={ fetch }
							data-on:keydown={ fkKeydown(props.Name) }
							data-on:blur={ fkBlur(props.Name) }
						/>
					} else if selectedLabel == "" {
						<span class="fk-combobox-static"></span>
					}
					@FkOptionList(FkOptionListProps{
						Name:    props.Name,
						Unique:  true,
						Options: props.Options,
					})
				</div>
			</div>
		</div>
		if props.Desc != "" {
			<p class="field-desc">{ props.Desc }</p>
		}
	</div>
}

templ SchemaEntityForeignKeyField(props SchemaEntityForeignKeyFieldProps) {
	{{ fetch := fkFetchIfOpen(props.OptionsURL, props.Name) }}
	<div class="field-group" data-signals={ templ.JSONString(fkManySignals(props.Name, props.Chips)) }>
		<div class="field">
			<span class="field-label">{ props.Label }</span>
			<div class="fk-combobox fk-combobox-many" data-class:is-open={ fkIsOpenExpr(props.Name) }>
				<div class="fk-combobox-face" data-on:mousedown="fkCombobox.focusFromFace(evt)">
					<div
						class="fk-chips"
						if props.Editable {
							data-editable="true"
							data-on:click={ fkRemoveManyClick(props.Name) }
						}
						data-effect={ fkRenderChipsEffect(props.Name) }
					></div>
					if props.Editable {
						<input
							type="text"
							class="fk-combobox-input"
							placeholder="Search..."
							role="combobox"
							aria-autocomplete="list"
							aria-controls={ fkOptionsElementID(props.Name) }
							autocomplete="off"
							spellcheck="false"
							data-bind={ fkSearchSignal(props.Name) }
							data-on:focus={ fkOpen(props.Name) }
							data-on:focus__debounce.200ms={ fetch }
							data-on:input={ fkOnInput(props.Name) }
							data-on:input__debounce.200ms={ fetch }
							data-on:keydown={ fkKeydown(props.Name) }
							data-on:blur={ fkBlur(props.Name) }
						/>
					}
					@FkOptionList(FkOptionListProps{
						Name:    props.Name,
						Unique:  false,
						Options: props.Options,
					})
				</div>
			</div>
		</div>
		if props.Desc != "" {
			<p class="field-desc">{ props.Desc }</p>
		}
	</div>
}
