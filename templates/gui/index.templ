package gui

import (
	"context"
	"encoding/json"
	"io"

	"github.com/troygilman/vent/requestctx"
)

templ Index() {
	{{ adminPath := requestctx.MustAdminPath(ctx) }}
	{{ datastarPath := templ.URL(adminPath + "static/js/datastar.js") }}
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta http-equiv="X-UA-Compatible" content="ie=edge"/>
			<meta name="csrf-token" content={ requestctx.MustCSRFToken(ctx) }/>
			<title>Vent Admin</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"/>
			<link rel="stylesheet" href={ templ.SafeURL(adminPath + "static/css/style.css") }/>
			<script src={ templ.SafeURL(adminPath + "static/js/common.js") }></script>
			@ImportMap(map[string]any{
				"imports": map[string]any{
					"datastar": datastarPath,
				},
			})
			<script type="module" src={ datastarPath }></script>
			<script type="module" src={ templ.URL(adminPath + "static/js/datastar-plugins.js") }></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

func ImportMap(data map[string]any) templ.Component {
	return templ.ComponentFunc(func(ctx context.Context, w io.Writer) error {
		b, err := json.Marshal(data)
		if err != nil {
			return err
		}
		_, err = io.WriteString(w, `<script type="importmap">`+string(b)+`</script>`)
		return err
	})
}
