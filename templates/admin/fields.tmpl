func (f {{ $node.Name }}{{ $member.SlotName }}) LoadOptions(ctx context.Context, search string, selectedIDs []int) ([]gui.SelectOption, error) {
	search = vent.OptionSearch(search)
	query := f.client.{{ $member.EdgeTypeName }}.Query().Order({{ lower $member.EdgeTypeName }}.ByID())
	{{- if $member.OptionSearchColumns }}
	if search != "" {
		query = query.Where({{ lower $member.EdgeTypeName }}.Or(
			{{- range $col := $member.OptionSearchColumns }}
			{{ lower $member.EdgeTypeName }}.{{ $col }}ContainsFold(search),
			{{- end }}
		))
	}
	{{- end }}
	{{- range $edge := $member.OptionPreloadEdges }}
	query = query.With{{ $edge }}()
	{{- end }}
	hits, err := query.Limit(vent.DefaultOptionLimit).All(ctx)
	if err != nil {
		return nil, err
	}

	var selected []*ent.{{ $member.EdgeTypeName }}
	if len(selectedIDs) > 0 {
		selectedQuery := f.client.{{ $member.EdgeTypeName }}.Query().
			Where({{ lower $member.EdgeTypeName }}.IDIn(selectedIDs...)).
			Order({{ lower $member.EdgeTypeName }}.ByID())
		{{- range $edge := $member.OptionPreloadEdges }}
		selectedQuery = selectedQuery.With{{ $edge }}()
		{{- end }}
		selected, err = selectedQuery.All(ctx)
		if err != nil {
			return nil, err
		}
	}

	entities := vent.UnionByID(hits, selected, func(entity *ent.{{ $member.EdgeTypeName }}) int { return entity.ID })
	selectedSet := make(map[int]struct{}, len(selectedIDs))
	for _, id := range selectedIDs {
		selectedSet[id] = struct{}{}
	}
	options := make([]gui.SelectOption, len(entities))
	for i, entity := range entities {
		_, isSelected := selectedSet[entity.ID]
		options[i] = gui.SelectOption{
			Value:    entity.ID,
			Label:    MustAdmin(ctx).{{ $member.EdgeTypeName }}().Name(entity),
			Selected: isSelected,
		}
	}
	return options, nil
}
