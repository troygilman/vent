			vent.HandleError(w, r, vent.BadRequest("invalid id").WithCause(err))
			return
		}

		e, err := h.client.{{ $node.Name }}.Get(r.Context(), id)
		if err != nil {
			vent.HandleError(w, r, normalizeError(err))
