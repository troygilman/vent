// put{{ $node.Name }}PasswordHandler returns the handler for PUT /admin/{{ $rc.RouteName }}/{id}/password/.
func (h *AdminHandler) put{{ $node.Name }}PasswordHandler() http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		id, err := strconv.Atoi(r.PathValue("id"))
		if err != nil {
			handleError(w, r, fmt.Errorf("invalid id"), http.StatusBadRequest)
			return
		}

		var signals struct {
			Password {{ $node.Name }}PasswordInput `json:"password"`
		}
		if err := datastar.ReadSignals(r, &signals); err != nil {
			h.patch{{ $node.Name }}PasswordPageError(w, r, id, fmt.Errorf("invalid form data: %w", err))
			return
		}
		input := signals.Password
		if input.Password == "" {
			h.patch{{ $node.Name }}PasswordPageError(w, r, id, errors.New("password is required"))
			return
		}
		if input.Password != input.ConfirmPassword {
			h.patch{{ $node.Name }}PasswordPageError(w, r, id, vent.ErrPasswordMismatch)
			return
		}

		hash, err := h.credentialGenerator.Generate(input.Password)
		if err != nil {
			h.patch{{ $node.Name }}PasswordPageError(w, r, id, err)
			return
		}
		if err := h.client.{{ $node.Name }}.UpdateOneID(id).SetPasswordHash(hash).Exec(r.Context()); err != nil {
			h.patch{{ $node.Name }}PasswordPageError(w, r, id, err)
			return
		}

		sse := datastar.NewSSE(w, r)
		sse.Redirect(fmt.Sprintf("%s{{ $rc.RouteName }}/%d/", requestctx.MustAdminPath(r.Context()), id))
	})
}

// delete{{ $node.Name }}PasswordHandler returns the handler for DELETE /admin/{{ $rc.RouteName }}/{id}/password/.
func (h *AdminHandler) delete{{ $node.Name }}PasswordHandler() http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		id, err := strconv.Atoi(r.PathValue("id"))
		if err != nil {
			handleError(w, r, fmt.Errorf("invalid id"), http.StatusBadRequest)
			return
		}

		currentUser, err := GetUser(r.Context())
		if err != nil {
			handleError(w, r, err, http.StatusInternalServerError)
			return
		}
		if currentUser.ID == id {
			h.patch{{ $node.Name }}PasswordPageError(w, r, id, errors.New("cannot remove your own password"))
			return
		}

		if err := h.client.{{ $node.Name }}.UpdateOneID(id).ClearPasswordHash().Exec(r.Context()); err != nil {
			h.patch{{ $node.Name }}PasswordPageError(w, r, id, err)
			return
		}

		sse := datastar.NewSSE(w, r)
		sse.Redirect(fmt.Sprintf("%s{{ $rc.RouteName }}/%d/", requestctx.MustAdminPath(r.Context()), id))
	})
}
