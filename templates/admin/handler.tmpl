				schema.GET("/add/{$}", h.get{{ $node.Name }}AddHandler(), h.authorize(h.schemas.{{ $node.Name }}.CanCreate))
				schema.GET("/{id}/", h.get{{ $node.Name }}Handler(), h.authorizePermission("read_{{ resourceName $node.Name }}"))
