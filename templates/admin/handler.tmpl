// buildLayoutProps creates LayoutProps with schema metadata visible to the current user.
func (h *AdminHandler) buildLayoutProps(ctx context.Context, activeSchemaName string, breadcrumbs []gui.BreadcrumbItem) gui.LayoutProps {
	schemas := make([]gui.SchemaMetadata, 0)
	if user, err := GetUser(ctx); err == nil {
		{{ range $item := $adminNodes }}
		{{ $node := $item.Node }}
		{{ $rc := $item.RC }}
		if ok, err := UserHasPermission(ctx, user, "read_{{ resourceName $node.Name }}"); err == nil && ok {
			schemas = append(schemas, gui.SchemaMetadata{
				Name:        "{{ $node.Name }}",
				DisplayName: "{{ $rc.PluralDisplayName }}",
				Path:        requestctx.MustAdminPath(ctx) + "{{ $rc.RouteName }}/",
			})
		}
		{{ end }}
	}
	slices.SortFunc(schemas, func(a, b gui.SchemaMetadata) int {
		return cmp.Compare(a.DisplayName, b.DisplayName)
	})
	return gui.LayoutProps{
		Schemas:          schemas,
		ActiveSchemaName: activeSchemaName,
		Breadcrumbs:      breadcrumbs,
	}
}

// handleError logs the error and sends an appropriate HTTP response
func handleError(w http.ResponseWriter, r *http.Request, err error, status int) {
	log.Printf("Error [%s %s]: %v", r.Method, r.URL.Path, err)
	http.Error(w, err.Error(), status)
}

func mutationErrorStatus(err error) int {
	switch {
	case ent.IsValidationError(err):
		return http.StatusBadRequest
	case ent.IsConstraintError(err):
		return http.StatusConflict
	case ent.IsNotFound(err):
		return http.StatusNotFound
	default:
		return http.StatusInternalServerError
	}
}

func mutationErrorMessage(err error) string {
	return err.Error()
}

func handleMutationError(w http.ResponseWriter, r *http.Request, err error) {
	handleError(w, r, err, mutationErrorStatus(err))
}

