		admin.Use(loggerMiddleware, requestctx.AdminPathMiddleware(adminBasePath), themeMiddleware)

		admin.Handle("/static/", vent.StaticDirHandler())

		admin.Use(csrfMiddleware)

		admin.GET("/login/", h.getLoginHandler())
		admin.POST("/login/", h.postLoginHandler())
		admin.POST("/logout/", h.postLogoutHandler())

		admin.Group("", func(authed *route.Router) {
			authed.Use(authMiddleware, userMiddleware, staffMiddleware)

			authed.POST("/preferences/theme/", h.postThemeHandler())
			authed.GET("/{$}", h.getAdminHandler())

			{{ range $item := $adminNodes }}
			{{ $node := $item.Node }}
			{{ $rc := $item.RC }}
			{{ $permSuffix := resourceName $node.Name }}
			authed.Group("{{ $rc.RouteName }}", func(schema *route.Router) {
				schema.GET("/", h.get{{ $node.Name }}ListHandler(), NewAuthorizationMiddleware("read_{{ $permSuffix }}"))
				schema.POST("/", h.post{{ $node.Name }}Handler(), NewAuthorizationMiddleware("create_{{ $permSuffix }}"))
				schema.GET("/add/{$}", h.get{{ $node.Name }}AddHandler(), NewAuthorizationMiddleware("create_{{ $permSuffix }}"))
				schema.GET("/{id}/", h.get{{ $node.Name }}Handler(), NewAuthorizationMiddleware("read_{{ $permSuffix }}"))
				schema.PATCH("/{id}/", h.patch{{ $node.Name }}Handler(), NewAuthorizationMiddleware("update_{{ $permSuffix }}"))
				schema.DELETE("/{id}/", h.delete{{ $node.Name }}Handler(), NewAuthorizationMiddleware("delete_{{ $permSuffix }}"))
				{{- if $rc.HasPasswordRoutes }}
				schema.GET("/{id}/password/", h.get{{ $node.Name }}PasswordHandler(), NewAuthorizationMiddleware("read_{{ $permSuffix }}"))
				schema.PUT("/{id}/password/", h.put{{ $node.Name }}PasswordHandler(), NewAuthorizationMiddleware("update_{{ $permSuffix }}"))
