// postThemeHandler returns the handler for POST /admin/preferences/theme/
func (h *AdminHandler) postThemeHandler() http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		newTheme := auth.NextTheme(requestctx.MustTheme(r.Context()))
		auth.SetThemeCookie(w, newTheme, requestctx.MustAdminPath(r.Context()), h.secureCookies)

		sse := datastar.NewSSE(w, r)
		if err := sse.ExecuteScript(fmt.Sprintf(`document.documentElement.setAttribute("data-theme", %q)`, newTheme)); err != nil {
			vent.HandleError(w, r, err)
			return
		}
		if err := sse.PatchElementTempl(gui.ThemeToggle(newTheme)); err != nil {
			vent.HandleError(w, r, err)
		}
	})
}

