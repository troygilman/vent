type OptionalInput[T any] struct {
	Set   bool
	Value *T
}

func (o *OptionalInput[T]) UnmarshalJSON(data []byte) error {
	o.Set = true
	if string(data) == "null" {
		o.Value = nil
		return nil
	}
	var value T
	if err := json.Unmarshal(data, &value); err != nil {
		return err
	}
	o.Value = &value
	return nil
}

func parseID(value string, label string) (int, error) {
	id, err := strconv.Atoi(value)
	if err != nil {
		return 0, vent.BadRequest(fmt.Sprintf("invalid %s id", label)).WithCause(err)
	}
	return id, nil
}

func parseIDList(values []string, label string) ([]int, error) {
	ids := make([]int, 0, len(values))
	for _, value := range values {
		id, err := parseID(value, label)
		if err != nil {
			return nil, err
		}
		ids = append(ids, id)
	}
	return ids, nil
}

