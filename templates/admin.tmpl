// post{{ $node.Name }}Handler returns the handler for POST /admin/{{ lower $node.Name }}s/
func (h *AdminHandler) post{{ $node.Name }}Handler() http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		var signals struct {
			Entity {{ $node.Name }}CreateInput `json:"entity"`
		}
		if err := datastar.ReadSignals(r, &signals); err != nil {
			h.patch{{ $node.Name }}AddPageError(w, r, fmt.Errorf("invalid form data: %w", err))
			return
		}
		input := signals.Entity

		builder := h.client.{{ $node.Name }}.Create()

		// Direct fields (no transformation)
		{{- range $field := $rc.CreateDirectFields }}
		{{- if $field.OptionalOnCreate }}
		if input.{{ pascal $field.Name }} != nil {
			{{- if isFieldKindTime $field.Kind }}
			if *input.{{ pascal $field.Name }} != "" {
				{{ pascal $field.Name }}Value, err := parseDateTimeLocalField(*input.{{ pascal $field.Name }}, "{{ $field.Name }}")
				if err != nil {
					h.patch{{ $node.Name }}AddPageError(w, r, err)
					return
				}
				{{- if $field.Nillable }}
				builder.SetNillable{{ pascal $field.Name }}(&{{ pascal $field.Name }}Value)
				{{- else }}
				builder.Set{{ pascal $field.Name }}({{ pascal $field.Name }}Value)
				{{- end }}
			}
			{{- else }}
