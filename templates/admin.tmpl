// build{{ $node.Name }}PageProps builds the edit page props for {{ $node.Name }}.
func (h *AdminHandler) build{{ $node.Name }}PageProps(ctx context.Context, id int, errorMessage string) (gui.SchemaEntityProps, error) {
	e, err := h.client.{{ $node.Name }}.Query().
		Where({{ lower $node.Name }}.IDEQ(id)).
		{{- range $edge := $rc.Edges }}
		With{{ pascal $edge.Name }}().
		{{- end }}
		Only(ctx)
	if err != nil {
		return gui.SchemaEntityProps{}, err
	}

	// Build selected edge IDs for multi-select fields
	{{- range $edge := $rc.Edges }}
	{{- if not $edge.Unique }}
	{{ lower $edge.Name }}IDs := make(map[int]struct{})
	for _, related := range e.Edges.{{ pascal $edge.Name }} {
		{{ lower $edge.Name }}IDs[related.ID] = struct{}{}
	}
	{{- end }}
	{{- end }}

	fields := []gui.SchemaEntityFieldProps{}

	{{ range $field := $rc.FormFields }}
	{{- if $field.IsPasswordStatus }}
	passwordStatus := "Not set"
	if passwordHashIsSet(e.PasswordHash) {
		passwordStatus = "Set"
	}
	fields = append(fields, gui.SchemaEntityFieldProps{
		Name:        "{{ $field.Name }}",
		Label:       "{{ $field.Label }}",
		Type:        vent.FieldKindString,
		Value:       passwordStatus,
		Editable:    false,
		ActionLabel: "Manage Password",
		ActionURL:   fmt.Sprintf("%s{{ $rc.RouteName }}/%d/password/", adminBasePath, id),
	})
	{{- else if eq $field.Name "id" }}
	fields = append(fields, gui.SchemaEntityFieldProps{
		Name:     "id",
		Label:    "ID",
		Type:     vent.FieldKindInt,
		Value:    fmt.Sprintf("%d", e.ID),
		Editable: false,
	})
	{{- else if $field.IsEdge }}
	// Load {{ $field.Name }} options
	{
		{{ lower $field.EdgeType }}Entities, err := h.client.{{ $field.EdgeType }}.Query().All(ctx)
		if err != nil {
			return gui.SchemaEntityProps{}, err
		}
		options := make([]gui.SelectOption, len({{ lower $field.EdgeType }}Entities))
		for i, opt := range {{ lower $field.EdgeType }}Entities {
			options[i] = gui.SelectOption{
				Value: opt.ID,
				Label: fmt.Sprintf("%v", opt.{{ $field.EdgeDisplayField }}),
				{{- if $field.EdgeUnique }}
				Selected: e.Edges.{{ pascal $field.Name }} != nil && e.Edges.{{ pascal $field.Name }}.ID == opt.ID,
				{{- else }}
				Selected: func() bool { _, ok := {{ lower $field.Name }}IDs[opt.ID]; return ok }(),
				{{- end }}
			}
		}
		fields = append(fields, gui.SchemaEntityFieldProps{
			Name:     "{{ $field.Name }}",
			Label:    "{{ $field.Label }}",
			Type:     {{ fieldKindGoIdent $field.Type }},
			Editable: true,
			Options:  options,
		})
	}
	{{- else if isFieldKindPassword $field.Type }}
	fields = append(fields, gui.SchemaEntityFieldProps{
		Name:     "{{ $field.Name }}",
		Label:    "{{ $field.Label }}",
		Type:     vent.FieldKindPassword,
		Editable: true,
	})
	{{- else }}
	fields = append(fields, gui.SchemaEntityFieldProps{
		Name:     "{{ $field.Name }}",
		Label:    "{{ $field.Label }}",
		Type:     {{ fieldKindGoIdent $field.Type }},
		Value:    formatFormValue(e.{{ pascal $field.Name }}),
		Editable: {{ $field.Editable }},
	})
	{{- end }}
	{{ end }}

	props := gui.SchemaEntityProps{
		LayoutProps:   h.buildLayoutProps("{{ $node.Name }}"),
		AdminPath:     adminBasePath,
		RouteName:     "{{ $rc.RouteName }}",
		EntityID:      id,
		EntityDisplay: fmt.Sprintf("%v", e.{{ $rc.DisplayField }}),
		ErrorMessage:  errorMessage,
		Fields:        fields,
	}
	return props, nil
}

